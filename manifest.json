{
  "schemaVersion": 1,
  "id": "jihonghe.opencode-dash",
  "name": "OpenCode Dash",
  "version": "1.0.0",
  "author": "jihonghe",
  "license": "MIT",
  "description": "OpenCode subscription quota in the Omarchy bar: remaining percentages, reset countdowns, and runway projections.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OpenCode Dash",
    "description": "OpenCode Go / Go Plus usage and remaining quota.",
    "category": "AI",
    "aliases": [
      "opencode",
      "dash",
      "dashboard",
      "quota",
      "usage",
      "runway",
      "fuel",
      "range",
      "gauge",
      "go"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300,
      "barWindows": "worst",
      "percentMode": "remaining",
      "warnRemaining": 20,
      "critRemaining": 10,
      "notifyEnabled": true,
      "notifyReset": false,
      "planLabel": "OpenCode Go"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 60,
        "max": 3600,
        "step": 60,
        "defaultValue": 300
      },
      {
        "key": "barWindows",
        "type": "enum",
        "label": "Bar display",
        "options": [
          "worst",
          "all",
          "month"
        ],
        "defaultValue": "worst"
      },
      {
        "key": "percentMode",
        "type": "enum",
        "label": "Percent meaning",
        "options": [
          "remaining",
          "used"
        ],
        "defaultValue": "remaining"
      },
      {
        "key": "warnRemaining",
        "type": "integer",
        "label": "Warn below remaining %",
        "min": 1,
        "max": 99,
        "defaultValue": 20
      },
      {
        "key": "critRemaining",
        "type": "integer",
        "label": "Critical below remaining %",
        "min": 1,
        "max": 99,
        "defaultValue": 10
      },
      {
        "key": "notifyEnabled",
        "type": "boolean",
        "label": "Notify on thresholds",
        "defaultValue": true
      },
      {
        "key": "notifyReset",
        "type": "boolean",
        "label": "Notify on reset",
        "defaultValue": false
      },
      {
        "key": "planLabel",
        "type": "enum",
        "label": "Plan",
        "defaultValue": "OpenCode Go",
        "options": [
          "OpenCode Go",
          "OpenCode Go Plus"
        ]
      }
    ]
  }
}
